<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main Menu -->
    <menuitem id="menu_hotel_root"
              name="Hotel"
              sequence="10"
              web_icon="gh_hotel_booking,static/description/icon.png"/>

    <!-- Bookings Menu -->
    <menuitem id="menu_hotel_bookings"
              name="Bookings"
              parent="menu_hotel_root"
              sequence="10"/>

    <menuitem id="menu_hotel_booking_all"
              name="All Bookings"
              parent="menu_hotel_bookings"
              action="action_hotel_booking"
              sequence="10"/>

    <menuitem id="menu_hotel_booking_calendar"
              name="Calendar"
              parent="menu_hotel_bookings"
              action="action_hotel_booking"
              sequence="20"/>

    <menuitem id="menu_today_checkins"
              name="Today's Check-ins"
              parent="menu_hotel_bookings"
              action="action_today_checkins"
              sequence="30"/>

    <menuitem id="menu_today_checkouts"
              name="Today's Check-outs"
              parent="menu_hotel_bookings"
              action="action_today_checkouts"
              sequence="40"/>

    <!-- Rooms Menu -->
    <menuitem id="menu_hotel_rooms"
              name="Rooms"
              parent="menu_hotel_root"
              action="action_hotel_room"
              sequence="20"/>

    <!-- Configuration Menu -->
    <menuitem id="menu_hotel_config"
              name="Configuration"
              parent="menu_hotel_root"
              sequence="100"/>

    <menuitem id="menu_hotel_rooms_config"
              name="Rooms"
              parent="menu_hotel_config"
              action="action_hotel_room"
              sequence="10"/>

    <!-- Bulk Create Wizard Menu Item -->
    <menuitem id="menu_bulk_create_rooms"
              name="Bulk Create Rooms"
              parent="menu_hotel_config"
              action="action_room_bulk_create_wizard"
              sequence="15"/>

    <!-- Payments Menu -->
    <menuitem id="menu_hotel_payments" 
            name="Payments" 
            parent="menu_hotel_root" 
            action="action_hotel_payment" 
            sequence="30"/>

    <!-- Data for Booking Sequence -->
    <data noupdate="1">
        <record id="seq_hotel_booking" model="ir.sequence">
            <field name="name">Hotel Booking</field>
            <field name="code">hotel.booking</field>
            <field name="prefix">BK</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>
