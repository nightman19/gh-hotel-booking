<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Payment List View -->
    <record id="view_hotel_payment_list" model="ir.ui.view">
        <field name="name">hotel.payment.list</field>
        <field name="model">hotel.payment</field>
        <field name="arch" type="xml">
            <list string="Payments" create="false">
                <field name="name"/>
                <field name="payment_date"/>
                <field name="guest_name"/>
                <field name="booking_id"/>
                <field name="amount" widget="monetary"/>
                <field name="payment_method"/>
                <field name="reference_number"/>
            </list>
        </field>
    </record>

    <!-- Payment Form View -->
    <record id="view_hotel_payment_form" model="ir.ui.view">
        <field name="name">hotel.payment.form</field>
        <field name="model">hotel.payment</field>
        <field name="arch" type="xml">
            <form string="Payment" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="booking_id"/>
                            <field name="guest_name"/>
                            <field name="payment_date"/>
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="payment_method"/>
                            <field name="reference_number"/>
                            <field name="booking_total" widget="monetary"/>
                            <field name="booking_balance" widget="monetary"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Payment notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Payment Action -->
    <record id="action_hotel_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">hotel.payment</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Payment Wizard Form -->
    <record id="view_hotel_payment_wizard_form" model="ir.ui.view">
        <field name="name">hotel.payment.wizard.form</field>
        <field name="model">hotel.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Payment">
                <sheet>
                    <group>
                        <group>
                            <field name="booking_id" invisible="1"/>
                            <field name="guest_name"/>
                            <field name="booking_total" widget="monetary"/>
                            <field name="amount_paid" widget="monetary"/>
                            <field name="balance" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <separator string="Payment Details"/>
                    <group>
                        <group>
                            <field name="payment_date"/>
                            <field name="amount" widget="monetary"/>
                            <field name="payment_method"/>
                        </group>
                        <group>
                            <field name="reference_number" 
                                   placeholder="e.g., MTN: 0241234567, Card: Last 4 digits"
                                   invisible="payment_method == 'cash'"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Additional notes..."/>
                    </group>
                </sheet>
                <footer>
                    <button string="Register Payment" name="action_register_payment" 
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
